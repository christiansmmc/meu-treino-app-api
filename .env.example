# Base64-encoded HS256 secret (mesmo formato do backend Java: Decoders.BASE64.decode)
JWT_SECRET=cVdEc0hHZTZ2NnpQd0xtQlR4S3lOdUpjWWZBc0RnUmhWbVFwWnJUdFdiTg==
DATABASE_URL=postgres://workout_sheet_api:workout_sheet_api@localhost:5432/workout_sheet_api_v2
# TLS obrigatório em providers gerenciados (Neon, RDS). Em local, deixe false/omitido.
DATABASE_SSL=false
PORT=8080
# Fuso usado para serializar `date` (YYYY-MM-DD) a partir de created_at
APP_TIMEZONE=America/Sao_Paulo
# Raiz das imagens/vídeos do catálogo servidos em GET /api/media/* (no container: /app/media, volume)
MEDIA_DIR=./media
# `bun run start:prod` (entrypoint do container) roda catalog:sync antes de subir o servidor
CATALOG_SYNC_ON_START=true
